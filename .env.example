# Prism — environment variables
# Copy to `.env.local` for local development.

# SQLite file (default) or Turso/libSQL remote URL
# Local:  file:prism.db
# Turso:  libsql://your-db.turso.io
DATABASE_URL=file:prism.db

# Required when DATABASE_URL points to a remote Turso database
# DATABASE_AUTH_TOKEN=

# Optional: set to "1" to skip live connector fetches in demo environments
# PRISM_DEMO_MODE=0
