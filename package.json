{
  "name": "prism",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:scores": "npx tsx src/db/compute-scores.ts",
    "companies:import": "npx tsx scripts/import-br-companies.ts",
    "companies:detect": "npx tsx scripts/detect-companies.ts",
    "companies:sync:p0": "npx tsx scripts/sync-companies.ts p0",
    "companies:sync:p1": "npx tsx scripts/sync-companies.ts p1",
    "companies:sync:p2": "npx tsx scripts/sync-companies.ts p2",
    "companies:sync:all": "npx tsx scripts/sync-companies.ts all",
    "jobs:sync:data": "npx tsx scripts/sync-data-opportunities.ts",
    "jobs:rescore": "npx tsx src/db/compute-scores.ts",
    "setup": "npm run db:push && npm run db:seed && npm run db:scores",
    "demo:seed": "npx tsx scripts/demo-seed.ts seed",
    "demo:reset": "npx tsx scripts/demo-seed.ts reset",
    "demo:prepare": "npx tsx scripts/prepare-demo-db.ts",
    "profile:personal": "npx tsx scripts/seed-personal-profile.ts",
    "profile:patch-schema": "npx tsx scripts/patch-profile-schema.ts",
    "test:e2e": "playwright test",
    "screenshots": "npx tsx scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@tanstack/react-query": "^5.100.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "node-cron": "^4.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
